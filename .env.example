# Required for real menu analysis in production.
ANTHROPIC_API_KEY=

# Owner access code (12+ chars). Entering it on the Profile page unlocks
# unlimited scans on this server's API key without sign-in. Leave empty to disable.
ADMIN_ACCESS_CODE=

# Production refuses paid analysis when the Upstash rate limiter is unavailable.
# Set to true only for a trusted local `next start` run without Redis.
RATE_LIMIT_FAIL_OPEN=false

# Local QA only. Never enable this in Vercel Production.
ENABLE_DEMO_ANALYSIS=false

# Product-validation hypothesis. Adjust without changing application code.
NEXT_PUBLIC_FREE_SCAN_LIMIT=3

# Optional integrations.
EXCHANGE_RATE_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Keep false until server-side entitlement verification is implemented.
ENABLE_STRIPE_CHECKOUT=false
NEXT_PUBLIC_SITE_URL=
